.meta{
  title: "Computing Infrastructure for Clinical AI"
  theme: "terminal"
  transition: zoom
  typography:
    baseline: presentation
  snippets:
    marker: "▸ "
  css:
    ".container":
        font-size: "40px"
    ".slide .body":
        font-size: "1.12em"
        line-height: "1.4"
    ".snippet":
        margin-bottom: "0.7rem"
    ".snippet::before":
        color: "#6a9955"
    ".slide h1":
        text-transform: "uppercase"
        color: "#4ec9b0"
        letter-spacing: "3px"
        font-size: "2.6em"
        line-height: "1.1"
        text-align: "left"
        text-shadow: "0 0 24px rgba(78, 201, 176, 0.45)"
        border-bottom: "2px solid #4ec9b0"
        padding-bottom: "0.15em"
        margin-bottom: "0.2em"
    ".slide h2":
        color: "#9cdcfe"
        font-size: "1.05em"
        font-weight: "400"
        text-align: "left"
        letter-spacing: "0.5px"
        margin-top: "0"
        margin-bottom: "0.8em"
    ".prompt":
        color: "#dcdcaa"
        background: "rgba(220, 220, 170, 0.08)"
        border-left: "4px solid #dcdcaa"
        padding: "14px 18px"
        margin-top: "28px"
        letter-spacing: "1px"
    ".dim":
        color: "#6a9955"
    ".navbar-container":
        display: "none"
    "#slide-1":
        --term-label: "'rudolph@artemis: ~/nsdf2026'"
    "#slide-2":
        --term-label: "'rudolph@artemis: ~ whoami'"
    "#slide-3":
        --term-label: "'rudolph@artemis: ~ whatido'"
    "#slide-1 h1":
        font-size: "2.2em"
    "#slide-4":
        --term-label: "'rudolph@artemis: ~ outline'"
    ".lbl":
        display: "inline-block"
        width: "20ch"
        text-indent: "0"
    ".bar":
        color: "#4ec9b0"
    ".pct":
        color: "#dcdcaa"
        font-weight: "bold"
        margin-left: "0.6ch"
    ".term .snippet:has(.lbl)::before, .term .snippet:has(> .dim:only-child)::before":
        content: "''"
    ".src":
        font-size: "0.5em"
        color: "#6a9955"
        margin-top: "0.6em"
        letter-spacing: "0.5px"
    ".pair":
        display: "inline-block"
        width: "19ch"
        text-indent: "0"
    ".pair > .dim":
        margin-left: "0.6ch"
    ".barp":
        color: "#4ec9b0"
    ".barpn":
        color: "#4ec9b0"
        font-weight: "bold"
        margin-left: "0.5ch"
    ".barg":
        color: "#c586c0"
    ".bargn":
        color: "#c586c0"
        font-weight: "bold"
        margin-left: "0.5ch"
    ".term .snippet:has(.pair)::before, .term .snippet:has(> .dim:only-child)::before":
        content: "''"
    ".grow":
        display: "inline-block"
        position: "relative"
        width: "0"
        vertical-align: "bottom"
        text-indent: "0"
        transition: "width 0.9s cubic-bezier(0.25, 0.8, 0.25, 1)"
    ".fill":
        display: "block"
        overflow: "hidden"
        white-space: "nowrap"
        text-indent: "0"
    ".snippet:not(.sl-hidden) .grow":
        width: "var(--w)"
    ".grow::after":
        content: "''"
        position: "absolute"
        top: "12%"
        bottom: "12%"
        right: "-0.25ch"
        width: "0.5ch"
        border-radius: "40%"
        background: "#ffffff"
        box-shadow: "0 0 10px 3px currentColor, 0 0 28px 10px currentColor"
        opacity: "1"
        pointer-events: "none"
    ".snippet:not(.sl-hidden) .grow::after":
        opacity: "0"
        transition: "opacity 0.45s ease-out 0.85s"
    ".snippet:not(.sl-hidden) .grow.g2":
        transition-delay: "0.25s"
    ".snippet:not(.sl-hidden) .grow.g2::after":
        transition: "opacity 0.45s ease-out 1.1s"
    ".grow.w1":
        --w: "1ch"
    ".grow.w2":
        --w: "2ch"
    ".grow.w3":
        --w: "3ch"
    ".grow.w4":
        --w: "4ch"
    ".grow.w5":
        --w: "5ch"
    ".grow.w6":
        --w: "6ch"
    ".grow.w7":
        --w: "7ch"
    ".grow.w8":
        --w: "8ch"
    ".grow.w9":
        --w: "9ch"
    ".grow.w10":
        --w: "10ch"
    ".grow.w11":
        --w: "11ch"
    ".grow.w12":
        --w: "12ch"
    ".grow.w13":
        --w: "13ch"
    ".grow.w14":
        --w: "14ch"
    ".grow.w15":
        --w: "15ch"
    ".grow.w16":
        --w: "16ch"
    ".grow.w17":
        --w: "17ch"
    ".grow.w18":
        --w: "18ch"
    ".grow.w19":
        --w: "19ch"
    ".grow.w20":
        --w: "20ch"
    ".grow.w21":
        --w: "21ch"
    "#slide-5":
        --term-label: "'rudolph@artemis: ~ 01 state'"
    "#slide-6":
        --term-label: "'rudolph@artemis: ~ 01 state'"
    "#slide-7":
        --term-label: "'rudolph@artemis: ~ 01 state'"
    "#slide-8":
        --term-label: "'rudolph@artemis: ~ 02 what is ai'"
    "#slide-9":
        --term-label: "'rudolph@artemis: ~ 02 what is ai'"
    "#slide-10":
        --term-label: "'rudolph@artemis: ~ 02 what is ai'"
    "#slide-11":
        --term-label: "'rudolph@artemis: ~ 03 compute'"
    "#slide-12":
        --term-label: "'rudolph@artemis: ~ 03 compute'"
    "#slide-13":
        --term-label: "'rudolph@artemis: ~ 03 compute'"
    "#slide-14":
        --term-label: "'rudolph@artemis: ~ 04 governance'"
    "#slide-15":
        --term-label: "'rudolph@artemis: ~ 04 governance'"
    "#slide-16":
        --term-label: "'rudolph@artemis: ~ 04 governance'"
    "#slide-17":
        --term-label: "'rudolph@artemis: ~ 05 infrastructure'"
    "#slide-18":
        --term-label: "'rudolph@artemis: ~ 05 infrastructure'"
    "#slide-19":
        --term-label: "'rudolph@artemis: ~ 05 infrastructure'"
    "#slide-20":
        --term-label: "'rudolph@artemis: ~ 06 what can be done'"
    "#slide-21":
        --term-label: "'rudolph@artemis: ~ 06 what can be done'"
    "#slide-22":
        --term-label: "'rudolph@artemis: ~ 06 what can be done'"
    "#slide-23":
        --term-label: "'rudolph@artemis: ~ 07 bubble'"
    "#slide-24":
        --term-label: "'rudolph@artemis: ~ 07 bubble'"
    "#slide-25":
        --term-label: "'rudolph@artemis: ~ 07 bubble'"
    "#slide-26":
        --term-label: "'rudolph@artemis: ~ 08 conclusions'"
    ".term .sd-nexus":
        margin-top: "0.6em"
    ".term .sd-nexus > div":
        margin-bottom: "0.45rem"
        padding-left: "1.2em"
    ".container > br":
        display: "none"
    ".term":
        position: "relative"
        background: "#141414"
        border: "1px solid #3e3e42"
        border-radius: "10px"
        box-shadow: "0 18px 50px rgba(0, 0, 0, 0.55)"
        padding: "88px 40px 30px 40px"
        margin: "30px 0 10px 0"
        width: "100%"
        box-sizing: "border-box"
    ".term::before":
        content: "var(--term-label, 'terminal')"
        position: "absolute"
        top: "0"
        left: "0"
        right: "0"
        height: "52px"
        line-height: "52px"
        text-align: "center"
        font-size: "0.6em"
        letter-spacing: "1px"
        color: "#858585"
        background: "radial-gradient(circle at 30px 50%, #ff5f57 9px, transparent 10px), radial-gradient(circle at 60px 50%, #febc2e 9px, transparent 10px), radial-gradient(circle at 90px 50%, #28c840 9px, transparent 10px), #2d2d30"
        border-bottom: "1px solid #3e3e42"
        border-radius: "10px 10px 0 0"
    ".slide .term pre":
        background: "none"
        border: "none"
        box-shadow: "none"
        padding: "0"
        margin: "0"
        font-size: "1em"
        color: "#4ec9b0"
    ".term > pre":
        margin-bottom: "0.5em"
    ".term .snippet":
        margin-bottom: "0.35rem"
        padding-left: "2.8em"
        text-indent: "-1.6em"
    ".term .snippet::before":
        display: "inline-block"
        width: "1.6em"
        margin-right: "0"
        text-indent: "0"
    ".term .snippet:has(pre)":
        padding-left: "0"
        text-indent: "0"
        margin-top: "1em"
        margin-bottom: "0.5em"
    ".term .snippet:has(pre)::before":
        display: "none"
    ".num":
        color: "#dcdcaa"
        font-weight: "bold"
    ".term > pre::after":
        content: "'▊'"
        color: "#4ec9b0"
        animation: "blink 500ms linear infinite alternate"
    ".term:has(> .snippet:not(.sl-hidden)) > pre::after, .term:has(> .sd-nexus) > pre.tw-done::after":
        content: "none"
        animation: "none"
    ".term > .snippet:not(.sl-hidden):not(:has(~ .snippet:not(.sl-hidden)))::after":
        content: "'▊'"
        color: "#4ec9b0"
        animation: "blink 500ms linear infinite alternate"
        margin-left: "0.15em"
    ".term > pre:not(.tw-done) ~ .sd-nexus > div, .term > pre:not(.tw-done) ~ .sd-nexus::after":
        visibility: "hidden"
    ".term > .sd-nexus::after":
        content: "'▊'"
        color: "#4ec9b0"
        animation: "blink 500ms linear infinite alternate"
        display: "block"
        padding-left: "1.2em"
    ".term > pre.tw-done ~ .sd-nexus::after":
        transition: "visibility 0s linear 0.6s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(1)":
        transition: "visibility 0s linear 0.00s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(2)":
        transition: "visibility 0s linear 0.07s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(3)":
        transition: "visibility 0s linear 0.14s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(4)":
        transition: "visibility 0s linear 0.21s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(5)":
        transition: "visibility 0s linear 0.28s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(6)":
        transition: "visibility 0s linear 0.35s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(7)":
        transition: "visibility 0s linear 0.42s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(8)":
        transition: "visibility 0s linear 0.49s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(9)":
        transition: "visibility 0s linear 0.56s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(10)":
        transition: "visibility 0s linear 0.63s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(11)":
        transition: "visibility 0s linear 0.70s"
    ".term > pre.tw-done ~ .sd-nexus > div:nth-child(12)":
        transition: "visibility 0s linear 0.77s"
    ".cursor":
        display: "inline-block"
        color: "#4ec9b0"
        font-weight: "bold"
        animation: "blink 500ms linear infinite alternate"
}

.slide{
  .title{Boot}
  .body{
    .h1{Computing Infrastructure for Clinical AI}
    .h2{Needs and challenges -- NSDF Summit on Federated Autonomous Science}

    .div{.class{dim} Rudolph Pienaar -- Boston Children's Hospital / Harvard Medical School}

    .div{.class{term}
.typewriter{$> ./talk --budget=10m --venue=nsdf}
    }
  }
}

.slide{
  .title{Whoami}
  .body{
    .h1{Rudolph Pienaar}
    .div{.class{term}
.typewriter{$> whoami --verbose}
      .o{Computational Scientist}
      .o{Systems Architect}
      .o{Brain Image Researcher}
      .o{.typewriter{$> info --educational}}
      .o{Assistant Professor of Radiology, Harvard Medical School}
      .o{PhD Biomedical Engineering -- BEng / MEng Electrical Engineering}
      .o{Thesis: reinforcement learning on dynamic physical systems}
    }
  }
}

.slide{
  .title{Whatido}
  .body{
    .h1{What I Do}
    .div{.class{term}
.typewriter{$> whatido --at=bch}
      .o{Build the infrastructure that runs research computation .bf{inside a hospital.}}
      .o{.bf{ChRIS} -- open-source platform: containerised analyses, run next to clinical data.}
      .o{.bf{HARBOR} -- a registry of .bf{processable} data. Find the cohort, send the compute to it.}
      .o{Hospital on one side, research cloud on the other. .bf{I live on the boundary.}}
    }

    .div{.class{prompt} THE HARD PART WAS NEVER THE MODEL. IT IS EVERYTHING AROUND IT.}
  }
}

.slide{
  .id{outline}
  .title{Outline}
  .body{
    .h1{Outline}
    .div{.class{term}
.typewriter{$> talk --outline}
    .nexus{.id{outline}
      .div{.jump{.target{state} Current State of "AI" in Hospitals}}
      .div{.jump{.target{what-is-ai} What Exactly Is "AI"?}}
      .div{.jump{.target{compute} What Is Computing in a Hospital?}}
      .div{.jump{.target{governance} Governance}}
      .div{.jump{.target{infrastructure} It's All About the Infrastructure}}
      .div{.jump{.target{what-next} What Can Be Done?}}
      .div{.jump{.target{bubble} The AI Bubble}}
      .div{.jump{.target{conclusions} Conclusions}}
    }
    }
  }
}

.slide{
  .id{state}
  .title{Current State of AI in Hospitals}
  .body{
    .h1{Current State of "AI" in Hospitals}
    .div{.class{term}
.typewriter{$> ai_status --site=bch}
      .o{Honestly? Not much -- not in the Northeast, not at Boston Children's.}
      .o{I deployed the only semi-production AI workflows in clinical radiology at BCH.}
      .o{They are .bf{predictive}: images in, labels and segmentations out.}
      .o{Generative AI is in use -- on .bf{text}: notes, documentation, productivity.}
      .o{Where it touches diagnosis it is .bf{advisory}: a human reads every output.}
    }
    .div{.class{src} Generative AI at BCH: Becker's Hospital Review 2024 · OpenAI customer story, May 2026 (vendor-published)}
  }
}

.slide{
  .id{state-2}
  .title{What the Numbers Say}
  .body{
    .h1{What the Numbers Say}
    .h2{How much AI is in US healthcare in 2026 -- and doing what?}
    .div{.class{term}
.typewriter{$> survey --year=2026}
      .o{.span{.class{dim} use any "AI" -- surveys don't say which kind; top uses are generative}}
      .o{.span{.class{lbl} health systems}.span{.class{grow bar w15}.span{.class{fill} ███████████████}}.span{.class{pct} 75%}}
      .o{.span{.class{lbl} physicians}.span{.class{grow bar w16}.span{.class{fill} ████████████████}}.span{.class{pct} 81%}}
      .o{.span{.class{dim} top use in health systems: ambient note-taking (generative)}}
      .o{.span{.class{lbl} clinical notes}.span{.class{grow bar w14}.span{.class{fill} █████████████▌}}.span{.class{pct} 68%}}
      .o{.span{.class{dim} FDA-cleared AI devices (predictive) that read images}}
      .o{.span{.class{lbl} radiology}.span{.class{grow bar w15}.span{.class{fill} ███████████████}}.span{.class{pct} 76%}}
      .o{1,614 FDA-cleared AI devices -- tagged as generative / LLM-based: .bf{none}.}
    }
    .div{.class{prompt} GENERATIVE AI WRITES THE NOTES. PREDICTIVE AI READS THE IMAGES.}
    .div{.class{src} Eliciting Insights via Fierce Healthcare, Mar 2026 (n=120 systems) · AMA physician survey, Mar 2026 (n=1,692) · FDA AI-enabled device list, counted Oct 2026 (1,230 of 1,614)}
  }
}

.slide{
  .id{state-end}
  .title{Current State of AI in Hospitals}
  .body{
    .h1{Current State of "AI" in Hospitals}
    .h2{What AI can do in a lab vs what hospitals actually run}
    .div{.class{term}
.typewriter{$> summary}
      .o{Deployed clinical AI: .bf{predictive}, mostly imaging.}
      .o{Generative AI: notes and documentation, a human in the loop.}
      .o{Agents now beat specialists .bf{in simulation} (88% vs 78%) -- yet finish only .bf{46%} of real EHR tasks.}
    }
    .div{.class{prompt} "AI IN HOSPITALS" IS MUCH SMALLER THAN THE HEADLINES.}
    .div{.class{src} Ferber et al., Nature 2026 (MIRA, simulated patients) · Liu et al., PhysicianBench, arXiv 2605.02240 (2026, preprint)}
  }
}

.slide{
  .id{what-is-ai}
  .title{What Exactly Is AI?}
  .body{
    .h1{What Exactly Is "AI"?}
    .div{.class{term}
.typewriter{$> whatis ai --honest}
      .o{Today, "AI" means .bf{LLMs}.}
      .o{But the AI delivering clinical value is .bf{pattern matching}: tumour detection, tissue labelling, segmentation.}
      .o{.bf{Predictive:} a deterministic forward pass. Rich input, bounded output.}
      .o{.bf{Generative:} samples one plausible answer from many. The probabilism is the task.}
    }
  }
}

.slide{
  .id{what-is-ai-2}
  .title{Can LLMs Read Images?}
  .body{
    .h1{Can LLMs Read Images?}
    .h2{Frontier AI vs radiologists on 200 hard image cases (RadLE 2.0, Jul 2026)}
    .div{.class{term}
.typewriter{$> benchmark --task=radiology --year=2026}
      .o{.span{.class{dim} score out of 2000: right answers earn points, confident wrong answers lose them}}
      .o{.span{.class{lbl} radiologists}.span{.class{grow bar w10}.span{.class{fill} █████████▌}}.span{.class{pct} 989}}
      .o{.span{.class{lbl} best AI model}.span{.class{grow bar w8}.span{.class{fill} ███████▌}}.span{.class{pct} 758}}
      .o{16 frontier models tested, incl. Gemini 3 Pro, GPT-5.6, Claude Fable 5. .bf{None} reached the radiologists.}
      .o{Diffusion models .bf{make and clean} images -- they don't read them.}
    }
    .div{.class{prompt} BEST MODEL: 23% BELOW RADIOLOGISTS -- AND OFTEN CONFIDENTLY WRONG.}
    .div{.class{src} CRASH Lab, RadLE 2.0 technical report, Jul 2026; scores via The Decoder, 19 Jul 2026 · Kazerouni et al., Med Image Anal 2023 (diffusion survey)}
  }
}

.slide{
  .id{what-is-ai-end}
  .title{What Exactly Is AI?}
  .body{
    .h1{What Exactly Is "AI"?}
    .div{.class{term}
.typewriter{$> diff predictive generative}
      .o{Same word, two machines -- they warrant .bf{different trust}.}
      .o{This session's example of the first kind: small-cohort multiomics predictors (Alter).}
      .o{On "trustworthy autonomy": in the clinic the trust problem is not autonomy -- it is .bf{telling the two apart.}}
    }
    .div{.class{prompt} CALL IT ALL "AI" AND YOU GOVERN IT ALL LIKE A CHATBOT.}
  }
}

.slide{
  .id{compute}
  .title{What Is Computing in a Hospital?}
  .body{
    .h1{What Is Computing in a Hospital?}
    .div{.class{term}
.typewriter{$> compute --inside=hospital}
      .o{For clinicians, until recently: Outlook and scheduling.}
      .o{Behind that: enterprise databases for billing.}
      .o{Computing as in .bf{actual computing}? Barely existed. Still barely does.}
      .o{Forget AI -- most hospitals can't do .bf{any} advanced computing.}
    }
  }
}

.slide{
  .id{compute-2}
  .title{Resources, Not Regions}
  .body{
    .h1{Resources, Not Regions}
    .h2{Predictive vs generative AI, by hospital type}
    .div{.class{term}
.typewriter{$> stats --ai --by=hospital --year=2024}
      .o{.span{.class{dim} % of US hospitals using each kind, built into the EHR (2024, same national survey)}}
      .o{.span{.class{lbl} }.span{.class{pair}.span{.class{barp} █}.span{.class{dim} predictive}}.span{.class{pair}.span{.class{barg} █}.span{.class{dim} generative}}}
      .o{.span{.class{lbl} all hospitals}.span{.class{pair}.span{.class{grow barp w7}.span{.class{fill} ███████}}.span{.class{barpn} 71%}}.span{.class{pair}.span{.class{grow barg w3 g2}.span{.class{fill} ███}}.span{.class{bargn} 31.5%}}}
      .o{.span{.class{lbl} in a health system}.span{.class{pair}.span{.class{grow barp w9}.span{.class{fill} ████████▌}}.span{.class{barpn} 86%}}.span{.class{pair}.span{.class{grow barg w4 g2}.span{.class{fill} ███▌}}.span{.class{bargn} 38.5%}}}
      .o{.span{.class{lbl} independent}.span{.class{pair}.span{.class{grow barp w4}.span{.class{fill} ███▌}}.span{.class{barpn} 37%}}.span{.class{pair}.span{.class{grow barg w2 g2}.span{.class{fill} █▌}}.span{.class{bargn} 16.3%}}}
      .o{.span{.class{lbl} urban}.span{.class{pair}.span{.class{grow barp w8}.span{.class{fill} ████████}}.span{.class{barpn} 81%}}.span{.class{pair}.span{.class{grow barg w4 g2}.span{.class{fill} ███▌}}.span{.class{bargn} 35.5%}}}
      .o{.span{.class{lbl} rural}.span{.class{pair}.span{.class{grow barp w6}.span{.class{fill} █████▌}}.span{.class{barpn} 56%}}.span{.class{pair}.span{.class{grow barg w3 g2}.span{.class{fill} ██▌}}.span{.class{bargn} 25.4%}}}
      .o{.span{.class{dim} predictive = ML or statistical risk models · generative = LLMs (ChatGPT, Gemini, DAX)}}
    }
    .div{.class{prompt} THE HYPE IS GENERATIVE. THE USE IS PREDICTIVE. BOTH FOLLOW THE MONEY.}
    .div{.class{src} Predictive: ASTP Data Brief 80, Sep 2025 · Generative: Everson et al., JAMA Netw Open 2025, Table 1 · both from the 2024 AHA IT Supplement; imaging AI outside the EHR not counted}
  }
}

.slide{
  .id{compute-end}
  .title{What Is Computing in a Hospital?}
  .body{
    .h1{What Is Computing in a Hospital?}
    .h2{Isn't the cloud the answer? Not yet.}
    .div{.class{term}
.typewriter{$> cloud --status
> 80%+ use a public cloud. Few have left on-prem.}
      .o{"Move to the cloud" mostly means a hosted EHR and some workloads -- .bf{not research computing.}}
      .o{43% of healthcare IT leaders name the .bf{skills gap} as the main cloud barrier.}
      .o{Planned 2026 spend on AI governance: large systems .bf{6.8%} of IT and quality budget, small hospitals .bf{2.3%}.}
    }
    .div{.class{prompt} THE GAP FOLLOWS MONEY AND SIZE.}
    .div{.class{src} KLAS via Becker's, Jul 2025 (n=36) · Rackspace State of Cloud 2025 (vendor, n=150) · Black Book via Becker's, Oct--Nov 2025 (n=182)}
  }
}

.slide{
  .id{governance}
  .title{Governance}
  .body{
    .h1{Governance}
    .div{.class{term}
.typewriter{$> governance --apply --to=practice}
      .o{Well-meaning people who can't define AI, writing policy to govern it.}
      .o{Every policy assumes "AI" means .bf{generative AI}.}
      .o{So it stalls on anything else.}
    }
  }
}

.slide{
  .id{governance-2}
  .title{The 100 MB Model}
  .body{
    .h1{The 100 MB Model}
    .div{.class{term}
.typewriter{$> review tissue-seg.pt}
      .o{.span{.class{dim} 100 MB · images in · images out · runs on a tablet}}
      .o{Q: hallucination guardrails? -- It does not sample. .bf{Deterministic forward pass.}}
      .o{Q: PHI leaking to big model companies? -- .bf{There is no text. Nothing leaves.}}
      .o{The process stalls anyway.}
    }
  }
}

.slide{
  .id{governance-end}
  .title{Governance}
  .body{
    .h1{Governance}
    .h2{How ready are hospitals to govern AI? (health-system surveys, late 2025)}
    .div{.class{term}
.typewriter{$> stats --governance}
      .o{Only .bf{18%} of health systems have mature AI governance and a full strategy.}
      .o{AI submissions outpace committee decisions .bf{~3:2} -- a growing backlog.}
      .o{Only .bf{22%} could produce an AI audit trail within 30 days.}
    }
    .div{.class{prompt} SCRUTINY IS HEAVIEST ON THE SAFEST MODELS.}
    .div{.class{src} HFMA/Eliciting Insights, Aug 2025 (n=233) · Elion, The AI Governance Playbook, Nov 2025 (vendor) · Black Book via Becker's, Oct--Nov 2025 (n=182)}
  }
}

.slide{
  .id{infrastructure}
  .title{It's All About the Infrastructure}
  .body{
    .h1{It's All About the Infrastructure}
    .div{.class{term}
.typewriter{$> grep -r infrastructure ./clinical-ai}
      .o{The .bf{first real need.}}
      .o{Places that didn't know computers could compute now need sophisticated computing.}
      .o{Cloud. Schedulers. Containers. Orchestration.}
      .o{Alien to IT departments built to install locked-down Windows desktops.}
    }
  }
}

.slide{
  .id{infrastructure-2}
  .title{This Room Already Knows}
  .body{
    .h1{This Room Already Knows}
    .div{.class{term}
.typewriter{$> cat nsdf/themes.txt}
      .o{Federated data access. Provenance. Workflow portability. Governance.}
      .o{Medicine needs exactly these -- under stricter rules.}
      .o{One difference: .bf{the data cannot move.}}
    }
  }
}

.slide{
  .id{infrastructure-end}
  .title{It's All About the Infrastructure}
  .body{
    .h1{It's All About the Infrastructure}
    .div{.class{term}
.typewriter{$> echo $BOTTLENECK
> infrastructure}
      .o{The value is in small predictive models. Hospitals can't .bf{run} them, and can't .bf{approve} them.}
      .o{Infrastructure is the common fix.}
    }
    .div{.class{prompt} THE HARD PART WAS NEVER THE MODEL.}
  }
}

.slide{
  .id{what-next}
  .title{What Can Be Done?}
  .body{
    .h1{What Can Be Done?}
    .div{.class{term}
.typewriter{$> plan --next}
      .o{.bf{Triage governance by what a model is:} images or text? local or remote? deterministic or sampled?}
      .o{A fast lane for small, local, image-in/image-out models.}
      .o{.bf{Shared infrastructure}, not a data centre per hospital: validated containers run next to the data (ChRIS).}
    }
  }
}

.slide{
  .id{what-next-2}
  .title{Move the Computation}
  .body{
    .h1{Move the Computation}
    .div{.class{term}
.typewriter{$> harbor --why}
      .o{Do not move the data. .bf{Move the computation.}}
      .o{Find the cohort, send the compute to it. Only results come back -- no images, no PHI.}
      .o{A small hospital joins with a key, not a data centre.}
      .o{The precondition for federation: federated learning (Xu) needs sites that .bf{can compute}.}
    }
    .div{.class{prompt} DO NOT MOVE THE DATA. MOVE THE QUESTION.}
  }
}

.slide{
  .id{what-next-end}
  .title{What Can Be Done?}
  .body{
    .h1{What Can Be Done?}
    .div{.class{term}
.typewriter{$> ask --audience=nsdf}
      .o{Treat hospitals as .bf{first-class sites} in national data fabrics.}
      .o{Networks to hospitals (Hart). Nodes that host clinical compute (Kirby). Shared standards (Musen).}
      .o{The hospital side brings the data and the questions.}
    }
    .div{.class{prompt} THE HOSPITALS LEAST ABLE TO COMPUTE NEED THIS MOST.}
  }
}

.slide{
  .id{bubble}
  .title{The AI Bubble}
  .body{
    .h1{The AI Bubble}
    .h2{What tech conferences rarely say: the numbers don't add up}
    .div{.class{term}
.typewriter{$> cat ai_economics.txt}
      .o{Gartner, 14 Oct: AI data centres need .bf{$8.5T} of revenue by 2030 to pay back; forecast is .bf{$3.6T}. Over .bf{80%} of neoclouds gone by 2030.}
      .o{IMF, 13 Oct: 14 "circular" AI deals -- ~$950B of equity and debt in exchange for .bf{$1.4T} of promised future revenue.}
      .o{Oracle: credit insurance at a record high (15 Oct); rated one notch above junk.}
      .o{OpenAI projects ~.bf{$278B} of cash burn 2026--2030. Anthropic: cash-flow breakeven not before ~2028 (reported).}
      .o{Ed Zitron has made this case for two years. This week Gartner caught up.}
    }
    .div{.class{src} Gartner via The Register, 14 Oct 2026 · IMF GFSR via TNW, 13 Oct 2026 · Oracle CDS: S&P/LSEG data via Securitas, 15 Oct 2026; S&P rating Jul 2026 · OpenAI: FT via Reuters, Sep 2026 · Anthropic: secondary reporting · Ed Zitron, Where's Your Ed At}
  }
}

.slide{
  .id{bubble-2}
  .title{The Gap, in Two Charts}
  .body{
    .h1{The Gap, in Two Charts}
    .h2{Revenue needed vs forecast, and data centres announced vs being built}
    .div{.class{term}
.typewriter{$> stats --ai-economics --to=2030}
      .o{.span{.class{dim} cumulative AI data-centre revenue to 2030, $ trillions}}
      .o{.span{.class{lbl} needed to pay back}.span{.class{grow bar w20}.span{.class{fill} ████████████████████}}.span{.class{pct} $8.5T}}
      .o{.span{.class{lbl} forecast}.span{.class{grow bar w8}.span{.class{fill} ████████}}.span{.class{pct} $3.6T}}
      .o{.span{.class{dim} US data-centre capacity slated to open in 2026, gigawatts}}
      .o{.span{.class{lbl} announced}.span{.class{grow bar w20}.span{.class{fill} ████████████████████}}.span{.class{pct} 16 GW}}
      .o{.span{.class{lbl} under construction}.span{.class{grow bar w6}.span{.class{fill} ██████}}.span{.class{pct} 5 GW}}
    }
    .div{.class{prompt} THE REVENUE ISN'T THERE. TWO-THIRDS OF THE BUILDINGS AREN'T STARTED.}
    .div{.class{src} Gartner, 14 Oct 2026 (via The Register) · Sightline Climate Data Center Outlook, Mar 2026 (via Utility Dive)}
  }
}

.slide{
  .id{bubble-end}
  .title{The AI Bubble}
  .body{
    .h1{The AI Bubble}
    .h2{What a crash would mean -- for hospitals and for science}
    .div{.class{term}
.typewriter{$> what-if --crash}
      .o{Economy: a burst could cut UK GDP by .bf{2.2%} (Bank of England); a correction would ripple through a "highly leveraged, circular" sector (IMF).}
      .o{Hospitals: generative AI is where the hype -- and the vendor risk -- sits. Repricing, failed vendors, stranded integrations.}
      .o{The small predictive models keep running: 100 MB, on-prem, no API to switch off.}
      .o{Science: a crash leaves cheap GPUs behind -- dark fibre after 2001, for federated compute.}
    }
    .div{.class{prompt} BUILD ON WHAT SURVIVES THE CRASH.}
    .div{.class{src} Bank of England Financial Stability Report, Jul 2026 (via Crypto Briefing) · IMF GFSR, Oct 2026 · implications are the speaker's argument}
  }
}

.slide{
  .id{conclusions}
  .title{Conclusions}
  .body{
    .h1{Conclusions}
    .div{.class{term}
.typewriter{$> exit
> questions? I have opinions.}
      .o{The AI that works in hospitals is .bf{small, predictive, and local}.}
      .o{Hospitals were built to run care, not computation.}
      .o{Governance written for LLMs blocks the models that already work.}
      .o{The fix: shared infrastructure, compute to the data -- and governance that can tell a segmentation model from a chatbot.}
    }
  }
}
